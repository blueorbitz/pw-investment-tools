# Investment Skills Network - Environment Configuration
# Copy this file to .env and fill in your values.
# The agent reads .env from the workspace root as a fallback when env vars are not set.

# Base path for all output (reports, scratch, portfolio, watchlist)
# Default: ~/notes
ISK_NOTES=~/notes

# Local Yahoo Finance data cache
# Default: ~/.cache
ISK_CACHE=~/.cache

# Path to src/ directory (for cross-skill script imports)
# Default: resolved relative to __file__ in each script
ISK_ROOT=

# FRED API key for US macro data (fed_liquidity.py, yield_curve.py)
# Get one free at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# SEC EDGAR identification (required by SEC for API access)
# Format: "YourName your@email.com"
SEC_EDGAR_USER_AGENT=

# BursaWhale API credentials for insider transaction data
BURSAWHALE_CLIENT_ID=
BURSAWHALE_CLIENT_SECRET=
